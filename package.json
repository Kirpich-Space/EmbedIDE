{
  "name": "embed-ide",
  "version": "2.6.2",
  "private": false,
  "description": "EmbedIDE — Offline-first engineering IDE for embedded flight computers",
  "author": {
    "name": "Kirpich-Space",
    "email": "yamanovaes1982@gmail.com",
    "url": "https://github.com/Kirpich-Space/EmbedIDE"
  },
  "license": "MIT",
  "homepage": "https://github.com/Kirpich-Space/EmbedIDE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kirpich-Space/EmbedIDE.git"
  },
  "bugs": {
    "url": "https://github.com/Kirpich-Space/EmbedIDE/issues"
  },
  "keywords": [
    "embedded",
    "ide",
    "stm32",
    "arm",
    "cortex-m",
    "rust",
    "c",
    "cpp",
    "zig",
    "avionics",
    "firmware",
    "drivers",
    "rtos",
    "openocd",
    "openrouter"
  ],
  "main": "electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "concurrently -k \"vite\" \"sleep 3 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "launch": "vite build && electron .",
    "toolchain:fetch": "node scripts/fetch-toolchains.mjs",
    "toolchain:fetch:rust": "EMBEDIDE_FETCH_RUST=1 node scripts/fetch-toolchains.mjs",
    "pack": "npm run bootstrap:prepare && vite build && electron-builder --dir",
    "dist:linux": "npm run bootstrap:prepare && vite build && electron-builder --linux AppImage deb pacman tar.gz",
    "dist:fedora": "npm run bootstrap:prepare && vite build && electron-builder --linux rpm",
    "dist:arch": "npm run bootstrap:prepare && vite build && electron-builder --linux pacman AppImage tar.gz",
    "dist:void": "npm run bootstrap:prepare && vite build && electron-builder --linux AppImage tar.gz",
    "dist:gentoo": "npm run bootstrap:prepare && vite build && electron-builder --linux AppImage tar.gz",
    "dist:win": "npm run bootstrap:prepare && vite build && electron-builder --win nsis portable",
    "dist:mac": "npm run bootstrap:prepare && vite build && electron-builder --mac dmg zip",
    "dist:all": "npm run bootstrap:prepare && vite build && electron-builder --linux AppImage deb rpm pacman tar.gz --win nsis portable",
    "postinstall": "electron-builder install-app-deps",
    "bootstrap:prepare": "node scripts/prepare-bootstrap.mjs",
    "dist:setup": "npm run dist:linux && cp packaging/linux/EmbedIDE-Setup.sh packaging/linux/install-toolchain.sh release/"
  },
  "build": {
    "appId": "com.kirpichspace.embedide",
    "productName": "EmbedIDE",
    "copyright": "Copyright © 2026 Kirpich Space",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons"
      },
      {
        "from": "build/bootstrap",
        "to": "bootstrap",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packaging/linux/install-toolchain.sh",
        "to": "install-toolchain.sh"
      },
      {
        "from": "packaging/windows/install-toolchain.ps1",
        "to": "install-toolchain.ps1"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icons/512.png",
      "synopsis": "Offline-first IDE for Cortex-M firmware",
      "description": "EmbedIDE — engineering IDE for embedded flight computers. The package installer downloads ARM GCC, OpenOCD, Zig and Rust during installation.",
      "desktop": {
        "entry": {
          "Name": "EmbedIDE",
          "GenericName": "Embedded IDE",
          "Comment": "Offline-first IDE for Cortex-M firmware",
          "Categories": "Development;IDE;",
          "StartupWMClass": "EmbedIDE",
          "Icon": "EmbedIDE"
        }
      },
      "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
      "executableName": "EmbedIDE"
    },
    "rpm": {
      "depends": [
        "libX11",
        "libXrandr",
        "libXdamage",
        "libXcomposite",
        "libXcursor",
        "libXfixes",
        "libXi",
        "mesa-libGL",
        "nss",
        "alsa-lib"
      ],
      "afterInstall": "packaging/linux/after-install.sh"
    },
    "pacman": {
      "depends": [
        "libx11",
        "libxrandr",
        "libxdamage",
        "libxcomposite",
        "libxcursor",
        "libxfixes",
        "libxi",
        "mesa",
        "nss",
        "alsa-lib"
      ],
      "afterInstall": "packaging/linux/after-install.sh"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "${name}-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EmbedIDE",
      "artifactName": "${name}-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${name}-${version}-windows-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/512.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "${name}-${version}-macos-${arch}.${ext}"
    },
    "deb": {
      "afterInstall": "packaging/linux/after-install.sh"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "codemirror": "^6.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
